# Copy to .env (never commit it). Values below match a local platform named "base".

# OAuth client of this app: the id you registered, and the secret printed once by `marketplace:app:register`.
CLIENT_ID=sample-app
CLIENT_SECRET=replace-with-the-secret-printed-at-registration

# Public origin of this app, without path.
APP_ORIGIN=https://sample-app.base.positive.test

# The only platforms this app accepts. Each: its API origin and its platform-app origin.
PLATFORMS={"base":{"apiOrigin":"https://api.base.positive.test","appOrigin":"https://app.base.positive.test"}}

# At least 32 random characters: signs the OAuth state cookie. `openssl rand -base64 32`
COOKIE_SECRET=replace-with-at-least-32-random-characters

PORT=3000
